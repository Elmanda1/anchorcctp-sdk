{
  "name": "@anchor-cctp/core-sdk",
  "version": "1.0.1",
  "description": "AnchorCCTP SDK Core Engine — accept USDC from any CCTP-connected chain on Stellar with a single function call.",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmanda1/anchorcctp-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Elmanda1/anchorcctp-sdk/issues"
  },
  "homepage": "https://github.com/Elmanda1/anchorcctp-sdk#readme",
  "scripts": {
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "jest --coverage"
  },
  "keywords": [
    "stellar",
    "cctp",
    "usdc",
    "anchor",
    "circle",
    "cross-chain"
  ],
  "author": "Mother's Grace (Juen)",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "13.3.0",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
